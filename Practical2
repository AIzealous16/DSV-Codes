import numpy as np 
import pandas as pd

#Create a numpy array
arr=np.array([20,40,60,80,100,120,140,160,180,200])
print("Numpy Array : ",arr)

#Calculate Statistics
print("Sum : ",arr.sum())
print("Mean : ",arr.mean())
print("Satandard Deviation : ",np.std(arr))

#Convert array into DataFrame
df=pd.DataFrame(arr,columns=['Numbers'])

print("\nNumpy Array Dataset")
print(df)

#Display first few records
print("\nFirst Few Records")
print(df.head())
