
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load Netflix dataset
df = pd.read_csv("netflix_titles.csv")

# 2. Display first 5 records
print("First 5 Records:")
print(df.head())

# 3. Dataset information
print("\nDataset Shape:", df.shape)
print("\nDataset Information:")
df.info()

# 4. Identify missing values
print("\nMissing Values:")
print(df.isnull().sum())

# 5. Data preprocessing
df = df.drop_duplicates()

df['director'] = df['director'].fillna("Unknown")
df['cast'] = df['cast'].fillna("Unknown")
df['country'] = df['country'].fillna("Unknown")
df['rating'] = df['rating'].fillna(df['rating'].mode()[0])

# Remove rows with missing title
df = df.dropna(subset=['title'])

print("\nCleaned Dataset:")
print(df.head())

# 6. Statistical analysis
print("\nStatistical Summary:")
print(df.describe(include='all'))

# 7. EDA: Movies vs TV Shows
df['type'].value_counts().plot(kind='bar')
plt.title("Movies vs TV Shows")
plt.xlabel("Type")
plt.ylabel("Count")
plt.show()

# 8. EDA: Top 10 countries
df['country'].value_counts().drop("Unknown", errors='ignore').head(10).plot(kind='bar')
plt.title("Top 10 Countries on Netflix")
plt.xlabel("Country")
plt.ylabel("Number of Titles")
plt.tight_layout()
plt.show()

# 9. EDA: Rating distribution
sns.countplot(data=df, x='rating',
              order=df['rating'].value_counts().index)
plt.title("Netflix Content Ratings")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# 10. Save cleaned dataset
df.to_csv("cleaned_netflix.csv", index=False)

print("\nCleaned dataset saved successfully!")

# Histogram
df["release_year"].hist()

plt.title("Release Year Distribution")
plt.show()
